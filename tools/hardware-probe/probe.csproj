<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <AssemblyName>probe</AssemblyName>
    <RootNamespace>Probe</RootNamespace>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin's real, model-independent logic. Driving these with live camera data tests the
         shipping code rather than a parallel reimplementation. -->
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FocusTravelMap.cs" Link="Plugin/FocusTravelMap.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FocusSettleTracker.cs" Link="Plugin/FocusSettleTracker.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FocusLimiterState.cs" Link="Plugin/FocusLimiterState.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FujiApiCapabilities.cs" Link="Plugin/FujiApiCapabilities.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FujifilmBatteryProtocol.cs" Link="Plugin/FujifilmBatteryProtocol.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FujifilmShutterSpeedCatalog.cs" Link="Plugin/FujifilmShutterSpeedCatalog.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FujifilmSensitivityCatalog.cs" Link="Plugin/FujifilmSensitivityCatalog.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FujifilmBulbCapability.cs" Link="Plugin/FujifilmBulbCapability.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/FujiCaptureQualityPlan.cs" Link="Plugin/FujiCaptureQualityPlan.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Configuration/CameraConfig.cs" Link="Plugin/CameraConfig.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Configuration/CameraModelRules.cs" Link="Plugin/CameraModelRules.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Settings/FujiSettings.cs" Link="Plugin/FujiSettings.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/LiveView/LiveViewEnums.cs" Link="Plugin/LiveViewEnums.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Devices/LiveView/LiveViewZoomLevels.cs" Link="Plugin/LiveViewZoomLevels.cs" />
    <Compile Include="../../src/NINA.Plugins.Fujifilm/Interop/FujifilmSdkWrapper.cs" Link="Plugin/FujifilmSdkWrapper.cs" />
    <None Include="../../src/NINA.Plugins.Fujifilm/Configuration/Assets/CameraConfigs/*.json" Link="CameraConfigs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
