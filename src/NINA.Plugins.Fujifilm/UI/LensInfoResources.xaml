<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rangefinder body with an X-mount lens motif. Kept monochrome so NINA can theme it. -->
    <GeometryGroup x:Key="NINA.Plugins.Fujifilm_FujiLensSVG" FillRule="EvenOdd">
        <PathGeometry Figures="M2,7 L6,7 L7.5,4 L13,4 L14.5,7 L22,7 L22,20 L2,20 Z
                               M4,9 L4,18 L20,18 L20,9 Z
                               M16,5 L20,5 L20,7 L16,7 Z" />
        <PathGeometry Figures="M7,13 A5,5 0 1 1 17,13 A5,5 0 1 1 7,13 Z
                               M9,13 A3,3 0 1 0 15,13 A3,3 0 1 0 9,13 Z" />
        <PathGeometry Figures="M9.6,10.6 L14.4,15.4 L13.4,16.4 L8.6,11.6 Z
                               M14.4,10.6 L15.4,11.6 L10.6,16.4 L9.6,15.4 Z" />
    </GeometryGroup>

    <!-- Minimal dockable panel for Fujifilm lens info -->
    <DataTemplate x:Key="NINA.Plugins.Fujifilm.UI.FujiLensInfoVM_Dockable">
        <Border Padding="6" Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Lens:"
                           Grid.Column="0"
                           Grid.Row="0"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding LensText}"
                           Grid.Column="1"
                           Grid.Row="0"
                           Foreground="{DynamicResource PrimaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock Text="Aperture:"
                           Grid.Column="0"
                           Grid.Row="1"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="SemiBold"
                           Margin="0,6,8,0"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="f/" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AvailableApertures}"
                              SelectedItem="{Binding SelectedAperture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanControlAperture}"
                              MinWidth="72" />
                </StackPanel>
                <TextBlock Text="Charging:"
                           Grid.Column="0"
                           Grid.Row="2"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="SemiBold"
                           Margin="0,6,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChargingText}"
                           Grid.Column="1"
                           Grid.Row="2"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Margin="0,6,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ApertureError}"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Grid.Row="3"
                           Foreground="OrangeRed"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
